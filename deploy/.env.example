# Copy to `.env` and fill in. Never commit the real .env.

# ---------- Postgres (the `db` service) ----------
POSTGRES_USER=sehaty
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=sehaty

# ---------- API ----------
# Points at the compose `db` service by name. The user / password / db name here
# MUST match the POSTGRES_* values above. Driver is psycopg (psycopg3).
DATABASE_URL=postgresql+psycopg://sehaty:CHANGE_ME_strong_db_password@db:5432/sehaty

# The secret that SIGNS auth tokens. Generate 32+ random bytes:
#   openssl rand -hex 32
# (This is SEHATY_JWT_SECRET — the one sehaty.core actually signs with.)
SEHATY_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# Comma-separated browser origins allowed to call the API (your Vercel URL).
# NOT a JSON array. Example: https://sehaty-front.vercel.app
CORS_ORIGINS=https://your-app.vercel.app

# Keep this "prod". (dev mode echoes OTP codes in responses — insecure.)
SEHATY_ENV=prod

# ---------- TLS / public hostname (Caddy) ----------
# Public host for the API. Caddy gets a Let's Encrypt cert for it automatically.
# Free stopgap until you own a domain — sslip.io maps a hostname to an IP:
#   api.<droplet-ip-with-dots>.sslip.io   e.g. api.203.0.113.10.sslip.io
SEHATY_API_HOST=api.203.0.113.10.sslip.io

# Email Let's Encrypt uses for expiry notices (optional but recommended).
ACME_EMAIL=you@example.com
